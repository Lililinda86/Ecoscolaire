            'feeAmount', 'feeT1', 'feeT2', 'feeT3', 'feeTransport', 'feeUniforms',
            'financialBypass', 'registrationFeeExpected', 'registrationFeePaid',
            'registrationFeeStatus', 'tuitionExpected', 'tuitionPaid', 'tuitionStatus',
            'transportMonthlyFee', 'transportPaid',
            'tuitionExpectedGross', 'tuitionDiscountTotal', 'tuitionExpectedNet', 'tuitionByInstallment',
            'transportExpectedGross', 'transportDiscountTotal', 'transportExpectedNet', 'transportByPeriod'
          ])
        &&
        !(
          isSecretary()
          && isUpdatingStudentActiveStatusFields()
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['schoolingStatus'])
        )
        && (
          (
            canManagePedagogy(request.resource.data.schoolId)
            && request.resource.data.schoolId == resource.data.schoolId
            // Les reclassements sont exclusivement transactionnels via assignStudentToClass (Admin SDK).
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['classId'])
          )
        )
        && hasAtomicCounterForStudentStatusUpdate(studentId, resource.data, request.resource.data)
      );
      // Delete (Désactivé physiquement pour la sécurité des données)
      allow delete: if false;
    }

    match /parents/{parentId} {
      // Les parents sont migrés dans `users`, mais si on garde une collection séparée pour l'historique
      allow read, write: if isAuthenticated() && isActive() && canManagePedagogy(resource.data.schoolId);
    }

    function hasNonEmptySpecialtyId(classData) {
      return 'specialtyId' in classData
        && classData.specialtyId is string
        && classData.specialtyId.size() > 0;
    }

    function hasValidTechnicalSpecialty(classData) {
      let specialtyPath = /databases/$(database)/documents/technicalSpecialties/$(classData.specialtyId);
      return classData.educationType == 'technical'
        && hasNonEmptySpecialtyId(classData)
        && exists(specialtyPath)
        && get(specialtyPath).data.schoolId == classData.schoolId
        && (
          !('isActive' in get(specialtyPath).data)
          || get(specialtyPath).data.isActive != false
        );
    }

    function isValidClassPayload(classData) {
      return (
        'educationType' in classData
        && classData.educationType == 'technical'
        && hasValidTechnicalSpecialty(classData)
      ) || (
        (
          !('educationType' in classData)
          || classData.educationType == 'general'
        )
        && !hasNonEmptySpecialtyId(classData)
      );
    }

    // --- CLASSES & SUBJECTS ---
    match /classes/{classId} {
      allow read: if isAuthenticated() && isActive() && !isBoardViewer() && hasSchoolAccess(resource.data.schoolId);
      allow create: if isAuthenticated()
        && isActive()
        && (isAdminOrOwner() || isDirector())
        && hasSchoolAccess(request.resource.data.schoolId)
        && isValidClassPayload(request.resource.data);
      allow update: if isAuthenticated()
        && isActive()
        && (isAdminOrOwner() || isDirector())
        && hasSchoolAccess(resource.data.schoolId)
        && request.resource.data.schoolId == resource.data.schoolId
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['educationType', 'specialtyId'])
          || isValidClassPayload(request.resource.data)
        );
      // Une classe se désactive; elle n'est jamais supprimée physiquement par un client.
      allow delete: if false;
    }
    match /subjects/{subjectId} {
      allow read: if isAuthenticated() && isActive() && !isBoardViewer() && hasSchoolAccess(resource.data.schoolId);
      allow create: if isAuthenticated()
        && isActive()
        && request.resource.data.schoolId is string
        && hasSchoolAccess(request.resource.data.schoolId)
        && isAcademicProgramManager()
        && request.resource.data.id is string
        && request.resource.data.id == subjectId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.matches('.*[^ \t\r\n].*')
        && request.resource.data.isActive == true
        && request.resource.data.createdAt is string
        && request.resource.data.createdBy is string
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedBy is string;
      allow update: if isAuthenticated()
        && isActive()
        && hasSchoolAccess(resource.data.schoolId)
        && request.resource.data.schoolId == resource.data.schoolId
        && isAcademicProgramManager()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['id', 'schoolId'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.matches('.*[^ \t\r\n].*')
        && request.resource.data.isActive is bool
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedBy is string;
      allow delete: if false;
    }
    match /technicalSpecialties/{specialtyId} {
      allow read: if isAuthenticated()
        && isActive()
        && !isBoardViewer()
        && hasSchoolAccess(resource.data.schoolId);

      allow create: if isAuthenticated()
        && isActive()
        && request.resource.data.schoolId is string
        && hasSchoolAccess(request.resource.data.schoolId)
        && (isAdminOrOwner() || isDirector())
        && request.resource.data.id is string
        && request.resource.data.id == specialtyId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.matches('.*[^ \t\r\n].*')
        && request.resource.data.isActive == true;

      allow update: if isAuthenticated()
        && isActive()
        && hasSchoolAccess(resource.data.schoolId)
        && request.resource.data.schoolId == resource.data.schoolId
        && (isAdminOrOwner() || isDirector())
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['id'])
        && (!('id' in resource.data) || (('id' in request.resource.data) && request.resource.data.id == resource.data.id && request.resource.data.id == specialtyId))
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.matches('.*[^ \t\r\n].*')
        && request.resource.data.isActive is bool;

      allow delete: if false;
    }

    match /classPrograms/{programId} {
      allow read: if isAuthenticated() && isActive() && hasSchoolAccess(resource.data.schoolId)
                  && (
                    isAcademicProgramManager() || isSecretary()
                    || (
                      isTeacher()
                      && resource.data.status == 'published'
                    )
                  );
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /classSubjects/{classSubjectId} {
      allow read: if isAuthenticated() && isActive() && hasSchoolAccess(resource.data.schoolId)
                  && (
                    isAcademicProgramManager() || isSecretary()
                    || (
                      isTeacher()
                      && exists(/databases/$(database)/documents/classPrograms/$(resource.data.programId))
                      && get(/databases/$(database)/documents/classPrograms/$(resource.data.programId)).data.schoolId == resource.data.schoolId
                      && 'publishedRevisionId' in get(/databases/$(database)/documents/classPrograms/$(resource.data.programId)).data
                      && resource.data.revisionId == get(/databases/$(database)/documents/classPrograms/$(resource.data.programId)).data.publishedRevisionId
                    )
                  );
      allow create, update: if false;
      allow delete: if false;
    }

    // --- STUDENT IMPORT JOBS ---
    match /student_import_jobs/{jobId} {
      allow read: if isAuthenticated() && isActive() && !isBoardViewer() && (isSuperAdmin() || hasSchoolAccess(resource.data.schoolId));
      allow create: if false; // Imports remain disabled before any job can be created.
      allow update, delete: if false; // Only Cloud Functions (Admin SDK) can update/delete
    }

    // --- GRADES & ATTENDANCE ---
    match /audit_logs/{logId} {
      allow create: if false; // Canonical audit records are written only by the trusted backend.
      allow read: if isSuperAdmin() || ((isOwner() || isDirector()) && resource.data.schoolId == getUserSchoolId());
      allow update, delete: if false; // Immuable
    }

    match /academicYears/{yearId} {
      allow read: if isAuthenticated() && isActive() && !isBoardViewer() && (resource == null || hasSchoolAccess(resource.data.schoolId));
      allow create: if isAuthenticated() && isActive() && (isAdminOrOwner() || isDirector()) && hasSchoolAccess(request.resource.data.schoolId);
      allow update: if isAuthenticated() && isActive() && (
        (isAdminOrOwner() || isDirector()) &&
        hasSchoolAccess(request.resource.data.schoolId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['openPeriodId'])
      );
      allow delete: if false;
    }

    match /periods/{periodId} {
      allow read: if isAuthenticated() && isActive() && (
        isSuperAdmin() ||
        ((isOwner() || isDirector() || isSecretary() || isTeacher()) &&
          (resource == null || hasSchoolAccess(resource.data.schoolId)))
      );
      // Every lifecycle mutation is performed by manageAcademicPeriod (Admin SDK).
      allow create, update, delete: if false;
    }

    match /evaluations/{evalId} {
      allow read: if isAuthenticated() && isActive() && hasSchoolAccess(resource.data.schoolId) && (
        isSuperAdmin() || isOwner() || isDirector() || isSecretary() ||
        (isTeacher() && resource.data.teacherUserId == request.auth.uid)
      );
      // Canonical lifecycle is exclusively managed by manageEvaluation.
      allow create, update, delete: if false;
    }

    match /grades/{gradeId} {
      allow read: if isAuthenticated() && isActive() && (
        isSuperAdmin() ||
        ((isOwner() || isDirector()) && hasSchoolAccess(resource.data.schoolId)) ||
        (isTeacher() && hasSchoolAccess(resource.data.schoolId) && resource.data.teacherUserId == request.auth.uid)
      );
      // Canonical batch writes are exclusively managed by recordGradesBatch.
      allow create, update, delete: if false;
    }

    match /reportCards/{reportCardId} {
      allow read: if isAuthenticated() && isActive() && (
        isSuperAdmin() ||
        ((isOwner() || isDirector() || isSecretary()) && hasSchoolAccess(resource.data.schoolId))
      );
      // Canonical lifecycle, including immutable publication, is exclusively
      // managed by manageReportCard. Physical deletion is never a business action.
      allow create, update, delete: if false;
    }

    match /gradeBatchRequests/{requestId} {
      allow read, create, update, delete: if false;
    }
    match /attendance/{attendanceId} {
      allow read: if isAuthenticated() && isActive() && !isBoardViewer() && hasSchoolAccess(resource.data.schoolId);
      // Canonical student attendance is written only by the trusted callable.
      allow create, update, delete: if false;
    }
    match /staff/{staffId} {
      // Staff documents can contain contact or legacy private fields. Keep the
      // complete document restricted to the operational management roles.
      allow read: if isAuthenticated() && isActive() && hasSchoolAccess(resource.data.schoolId)
                  && (isSuperAdmin() || isOwner() || isDirector() || isSecretary());
      // Lifecycle writes are backend-only so schoolId, actor and timestamps are
      // derived by manageStaff and identity-link fields cannot be forged.
      allow create, update, delete: if false;
    }
    match /staffAttendance/{attendanceId} {
      allow read: if isAuthenticated() && isActive() && canManagePedagogy(resource.data.schoolId);
      allow create: if isAuthenticated() && isActive()
                    && canManagePedagogy(request.resource.data.schoolId)
                    && attendanceId == 'staff_' + request.resource.data.schoolId + '_' + request.resource.data.date + '_' + request.resource.data.staffId;
      allow update: if isAuthenticated() && isActive()
                    && canManagePedagogy(resource.data.schoolId)
                    && request.resource.data.schoolId == resource.data.schoolId
                    && request.resource.data.staffId == resource.data.staffId
                    && request.resource.data.date == resource.data.date
                    && attendanceId == 'staff_' + resource.data.schoolId + '_' + resource.data.date + '_' + resource.data.staffId;
      allow delete: if false;
    }
    match /staffUserLinks/{linkId} {
      allow read: if isAuthenticated() && isActive() && (
        isSuperAdmin() ||
        ((isOwner() || isDirector()) && hasSchoolAccess(resource.data.schoolId))
      );
      allow write: if false;
    }
    match /staffUserLinkByUser/{userId} {
      allow read: if isAuthenticated() && isActive() && (
        request.auth.uid == userId ||
        isSuperAdmin() ||
        ((isOwner() || isDirector()) && hasSchoolAccess(resource.data.schoolId))
      );
      allow write: if false;
    }
    match /staffUserLinkByStaff/{pointerId} {
      allow read: if isAuthenticated() && isActive() && (
        isSuperAdmin() ||
        ((isOwner() || isDirector()) && hasSchoolAccess(resource.data.schoolId))
      );
      allow write: if false;
    }

    // --- FINANCE (PAYMENTS & EXPENSES) ---
    match /financialBenefits/{benefitId} {
      allow read: if isAuthenticated() && isActive() && (
        isSuperAdmin() ||
        ((isOwner() || isDirector() || isSecretary() || isAccountant())
          && hasSchoolAccess(resource.data.schoolId))
      );
      // Canonical benefits are created, approved and consumed by Functions only.
      allow create, update, delete: if false;
    }

    match /financialBenefitReferences/{referenceId} {
      allow read: if isAuthenticated() && isActive() && (
        isSuperAdmin() ||
        ((isOwner() || isDirector() || isAccountant())
          && hasSchoolAccess(resource.data.schoolId))
      );
      allow create, update, delete: if false;
    }

    match /paymentMoratoriums/{moratoriumId} {
      allow read: if isAuthenticated() && isActive() && (
        isSuperAdmin() ||
        ((isOwner() || isDirector() || isSecretary() || isAccountant())
          && hasSchoolAccess(resource.data.schoolId))
      );
      // Un moratoire déplace l'exigibilité sans diminuer la dette. Il est géré
      // exclusivement par le backend afin de préserver son historique.
      allow create, update, delete: if false;
    }

    match /transactions/{transactionId} {
      allow read: if isAuthenticated() && isActive() && !isBoardViewer() && (
        resource.data.userId == request.auth.uid ||
        isSuperAdmin() ||
        ((isOwner() || isDirector() || isAccountant() || isSecretary()) && hasSchoolAccess(resource.data.schoolId))
      );
      allow create, update, delete: if false;
    }

    match /payments/{paymentId} {
      allow read: if isAuthenticated() && isActive() && (
        isSuperAdmin() ||
        ((isOwner() || isDirector() || isSecretary() || isAccountant()) && hasSchoolAccess(resource.data.schoolId)) ||
        (isParent() && hasSchoolAccess(resource.data.schoolId) && resource.data.studentId in getUserData().get('studentIds', []))
      );
      // Le grand livre des encaissements est alimenté uniquement par le backend canonique.
      allow create, update, delete: if false;
    }
    match /transportPaymentAllocations/{allocationId} {
      allow read: if isAuthenticated() && isActive() && (
        isSuperAdmin() ||
        ((isOwner() || isDirector() || isSecretary() || isAccountant())
          && hasSchoolAccess(resource.data.schoolId)) ||
        (isParent() && hasSchoolAccess(resource.data.schoolId)
          && resource.data.studentId in getUserData().get('studentIds', []))
      );
      allow create, update, delete: if false;
    }
    match /receipts/{receiptId} {
      allow read: if isAuthenticated() && isActive() && (
        isSuperAdmin() ||
        ((isOwner() || isDirector() || isSecretary() || isAccountant()) && hasSchoolAccess(resource.data.schoolId)) ||
        (isParent() && hasSchoolAccess(resource.data.schoolId)
          && resource.data.studentId in getUserData().get('studentIds', []))
      );
      // Écritures gérées uniquement par le backend avec Firebase Admin SDK.
      allow write: if false;
    }
    match /expenses/{expenseId} {
      allow get: if isAuthenticated()
        && isActive()
        && (
          (
            (isAdminOrOwner() || isDirector())
            && (
              !exists(/databases/$(database)/documents/expenses/$(expenseId))
              || hasSchoolAccess(resource.data.schoolId)
            )
          )
          ||
          (
            (isAccountant() || isSecretary())
            && exists(/databases/$(database)/documents/expenses/$(expenseId))
            && hasSchoolAccess(resource.data.schoolId)
          )
        );
      allow list: if isAuthenticated() && isActive() && (isAdminOrOwner() || isAccountant() || isSecretary()) && hasSchoolAccess(resource.data.schoolId);
      // Création et contre-passation passent exclusivement par les callables atomiques.
      // Un document financier publié n'est jamais modifié ni supprimé par un client.
      allow create, update, delete: if false;
    }

    // --- INVENTORY ---
    match /inventory/{itemId} {
      allow read: if isAuthenticated() && isActive() && !isBoardViewer() && hasSchoolAccess(resource.data.schoolId);
      allow write: if isAuthenticated() && isActive() && (isAdminOrOwner() || isSecretary() || isAccountant()) && hasSchoolAccess(request.resource.data.schoolId);
    }
    match /inventoryTransactions/{txId} {
      allow read: if isAuthenticated() && isActive() && (isAdminOrOwner() || isSecretary() || isAccountant()) && hasSchoolAccess(resource.data.schoolId);
      allow write: if isAuthenticated() && isActive() && (isAdminOrOwner() || isSecretary() || isAccountant()) && hasSchoolAccess(request.resource.data.schoolId);
    }

    // --- TRANSPORT ---
    function isDriverBreakdownCreation(data, docId) {
      return data.keys().hasOnly(['id', 'schoolId', 'date', 'busId', 'description', 'severity', 'status'])
          && data.keys().hasAll(['id', 'schoolId', 'date', 'busId', 'description', 'severity', 'status'])
          && data.id == docId
          && data.schoolId is string && data.schoolId != '' && hasSchoolAccess(data.schoolId)
          && data.busId is string && data.busId != ''
          && data.description is string && data.description != ''
          && data.severity in ['légère', 'moyenne', 'urgente']
          && data.status == 'signalée'
          && data.date is string && data.date != ''
          && exists(/databases/$(database)/documents/buses/$(data.busId))
          && get(/databases/$(database)/documents/buses/$(data.busId)).data.schoolId == data.schoolId;
    }

    match /buses/{busId} {
      allow read: if isAuthenticated() && isActive() && hasSchoolAccess(resource.data.schoolId) && (isAdminOrOwner() || isDirector() || isSecretary() || isAccountant() || isDriver() || canSecretaryManageAllTransport(resource.data.schoolId));
      allow create: if isAuthenticated() && isActive() && request.resource.data.schoolId is string && hasSchoolAccess(request.resource.data.schoolId) && (isAdminOrOwner() || isDirector() || isSecretary() || canSecretaryManageAllTransport(request.resource.data.schoolId));
      allow update: if isAuthenticated() && isActive() && hasSchoolAccess(resource.data.schoolId) && request.resource.data.schoolId == resource.data.schoolId && (isAdminOrOwner() || isDirector() || isSecretary() || canSecretaryManageAllTransport(resource.data.schoolId));
      allow delete: if false;
    }
    match /busRoutes/{routeId} {
      allow read: if isAuthenticated() && isActive() && hasSchoolAccess(resource.data.schoolId) && (isAdminOrOwner() || isDirector() || isSecretary() || canSecretaryManageAllTransport(resource.data.schoolId));
      allow create: if isAuthenticated() && isActive() && request.resource.data.schoolId is string && hasSchoolAccess(request.resource.data.schoolId) && (isAdminOrOwner() || isDirector() || isSecretary() || canSecretaryManageAllTransport(request.resource.data.schoolId));
      allow update: if isAuthenticated() && isActive() && hasSchoolAccess(resource.data.schoolId) && request.resource.data.schoolId == resource.data.schoolId && (isAdminOrOwner() || isDirector() || isSecretary() || canSecretaryManageAllTransport(resource.data.schoolId));
      allow delete: if false;
    }
    match /fuelExpenses/{expId} {
      allow read: if isAuthenticated() && isActive() && hasSchoolAccess(resource.data.schoolId) && (isAdminOrOwner() || isDirector() || isAccountant() || canSecretaryManageAllTransport(resource.data.schoolId));
      allow create: if isAuthenticated() && isActive() && request.resource.data.schoolId is string && hasSchoolAccess(request.resource.data.schoolId) && (isAdminOrOwner() || isDirector() || isAccountant() || canSecretaryManageAllTransport(request.resource.data.schoolId));
      allow update: if isAuthenticated() && isActive() && hasSchoolAccess(resource.data.schoolId) && request.resource.data.schoolId == resource.data.schoolId && (isAdminOrOwner() || isDirector() || isAccountant() || canSecretaryManageAllTransport(resource.data.schoolId));
      allow delete: if false;
    }
    match /maintenances/{mId} {
      allow read: if isAuthenticated() && isActive() && hasSchoolAccess(resource.data.schoolId) && (isAdminOrOwner() || isDirector() || isAccountant() || canSecretaryManageAllTransport(resource.data.schoolId));
      allow create: if isAuthenticated() && isActive() && request.resource.data.schoolId is string && hasSchoolAccess(request.resource.data.schoolId) && (isAdminOrOwner() || isDirector() || isAccountant() || canSecretaryManageAllTransport(request.resource.data.schoolId));
      allow update: if isAuthenticated() && isActive() && hasSchoolAccess(resource.data.schoolId) && request.resource.data.schoolId == resource.data.schoolId && (isAdminOrOwner() || isDirector() || isAccountant() || canSecretaryManageAllTransport(resource.data.schoolId));
      allow delete: if false;
    }
    match /breakdowns/{bId} {
      allow read: if isAuthenticated() && isActive() && hasSchoolAccess(resource.data.schoolId) && (isAdminOrOwner() || isDirector() || isDriver() || canSecretaryManageAllTransport(resource.data.schoolId));
      allow create: if isAuthenticated() && isActive() && request.resource.data.schoolId is string && hasSchoolAccess(request.resource.data.schoolId) && (isAdminOrOwner() || isDirector() || canSecretaryManageAllTransport(request.resource.data.schoolId) || (isDriver() && isDriverBreakdownCreation(request.resource.data, bId)));
      allow update: if isAuthenticated() && isActive() && hasSchoolAccess(resource.data.schoolId) && request.resource.data.schoolId == resource.data.schoolId && (isAdminOrOwner() || isDirector() || canSecretaryManageAllTransport(resource.data.schoolId));
      allow delete: if false;
    }

    match /validation_requests/{reqId} {
      // N'importe quel membre du staff peut créer une requête
      allow create: if isAuthenticated() && isActive() && !isBoardViewer() && hasSchoolAccess(request.resource.data.schoolId)
                    && !(isSecretary() && request.resource.data.actionType == 'DELETE_STUDENT');
      // Tout le staff peut lire les requêtes de son école
      allow read: if isAuthenticated() && isActive() && !isBoardViewer() && hasSchoolAccess(resource.data.schoolId);
      // Seuls les approbateurs peuvent modifier/résoudre
      allow update: if isAuthenticated() && isActive() && (isAdminOrOwner() || isDirector())
                    && hasSchoolAccess(resource.data.schoolId)
                    && resource.data.status == 'pending'
                    && !(isSecretary() && (resource.data.actionType == 'DELETE_STUDENT' || request.resource.data.actionType == 'DELETE_STUDENT'))
                    && (
                      (request.resource.data.status == 'approved'
                       && request.resource.data.approvedBy == request.auth.uid
                       && request.resource.data.approvedAt == request.time
                       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'approvedBy', 'approvedAt'])
                      ) ||
                      (request.resource.data.status == 'rejected'
                       && request.resource.data.rejectedBy == request.auth.uid
                       && request.resource.data.rejectedAt == request.time
                       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'rejectedBy', 'rejectedAt'])
                      )
                    )
                    && (resource.data.requesterId != request.auth.uid || isAdminOrOwner() || isDirector());
      allow delete: if false;
    }

    // --- NOTIFICATIONS ---
    match /notifications/{notifId} {
      // Le Conseil ne peut lire que ses propres notifications et ne peut jamais les muter.
      allow read: if isAuthenticated() && isActive() && hasSchoolAccess(resource.data.schoolId)
                  && (!isBoardViewer() || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && isActive() && !isBoardViewer() && hasSchoolAccess(request.resource.data.schoolId);
      allow update, delete: if isAuthenticated() && isActive() && !isBoardViewer() && hasSchoolAccess(resource.data.schoolId);
    }

    // --- CASH CLOSURES ---
    match /cashClosures/{closureId} {
      allow get, list: if isAuthenticated() && isActive() && (isSuperAdmin() || (resource.data.schoolId == getUserSchoolId() && (isOwner() || isDirector() || isSecretary() || isAccountant())));
      allow create, update, delete: if false;
    }

    // Transactional backend-only serialization point for payments/reversals/closure.
    match /cashLedgerDays/{ledgerId} {
      allow read, write: if false;
    }

    // --- TEACHER ASSIGNMENTS ---
    match /teacherAssignments/{assignmentId} {
      allow read: if isAuthenticated() && isActive() && (
        isSuperAdmin() ||
        ((isOwner() || isDirector() || isSecretary()) && hasSchoolAccess(resource.data.schoolId)) ||
        (
          isTeacher()
          && hasSchoolAccess(resource.data.schoolId)
          && resource.data.isActive == true
          && exists(/databases/$(database)/documents/staffUserLinkByUser/$(request.auth.uid))
          && get(/databases/$(database)/documents/staffUserLinkByUser/$(request.auth.uid)).data.isActive == true
          && get(/databases/$(database)/documents/staffUserLinkByUser/$(request.auth.uid)).data.schoolId == resource.data.schoolId
          && get(/databases/$(database)/documents/staffUserLinkByUser/$(request.auth.uid)).data.staffId == resource.data.teacherStaffId
        )
      );
      allow write: if false;
    }

    match /teacherAssignmentSlots/{slotId} {
      allow read: if isAuthenticated() && isActive() && (
        isSuperAdmin() ||
        ((isOwner() || isDirector() || isSecretary()) && hasSchoolAccess(resource.data.schoolId)) ||
        (
          isTeacher()
          && hasSchoolAccess(resource.data.schoolId)
          && resource.data.isActive == true
          && exists(/databases/$(database)/documents/staffUserLinkByUser/$(request.auth.uid))
          && get(/databases/$(database)/documents/staffUserLinkByUser/$(request.auth.uid)).data.isActive == true
          && get(/databases/$(database)/documents/staffUserLinkByUser/$(request.auth.uid)).data.schoolId == resource.data.schoolId
          && get(/databases/$(database)/documents/staffUserLinkByUser/$(request.auth.uid)).data.staffId == resource.data.teacherStaffId
        )
      );
      allow write: if false;
    }
  }
}
