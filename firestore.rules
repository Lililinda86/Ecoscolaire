rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // UTILS : FONCTIONS DE SÉCURITÉ
    // ==========================================


    function isStrictGradePayload(data) {
      return data.keys().hasAll(['academicYearId', 'periodId', 'evaluationId', 'classId', 'classSubjectId']);
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isValidEvaluationStatusTransition(oldStatus, newStatus, role) {
      return (
        (role == 'teacher' && (
          (oldStatus == 'NEW' && newStatus == 'draft') ||
          (oldStatus == 'draft' && newStatus == 'draft') ||
          (oldStatus == 'draft' && newStatus == 'submitted') ||
          (oldStatus == 'submitted' && newStatus == 'draft')
        )) ||
        (role == 'director' && (
          (oldStatus == 'NEW' && (newStatus == 'draft' || newStatus == 'validated')) ||
          (oldStatus == 'draft' && (newStatus == 'draft' || newStatus == 'validated')) ||
          (oldStatus == 'submitted' && (newStatus == 'draft' || newStatus == 'validated')) ||
          (oldStatus == 'validated' && (newStatus == 'draft' || newStatus == 'validated' || newStatus == 'locked'))
        )) ||
        (role == 'owner' || role == 'superAdmin')
      );
    }

    function isValidGradeStatusTransition(oldStatus, newStatus, role) {
      return (
        (role == 'teacher' && (
          (oldStatus == 'NEW' && newStatus == 'draft') ||
          (oldStatus == 'draft' && newStatus == 'draft') ||
          (oldStatus == 'draft' && newStatus == 'submitted') ||
          (oldStatus == 'submitted' && newStatus == 'draft')
        )) ||
        (role == 'director' && (
          (oldStatus == 'NEW' && (newStatus == 'draft' || newStatus == 'validated')) ||
          (oldStatus == 'draft' && (newStatus == 'draft' || newStatus == 'validated')) ||
          (oldStatus == 'submitted' && (newStatus == 'draft' || newStatus == 'validated')) ||
          (oldStatus == 'validated' && (newStatus == 'draft' || newStatus == 'validated' || newStatus == 'locked'))
        )) ||
        (role == 'owner' || role == 'superAdmin')
      );
    }

    function currentUserDocExists() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      // Les données de l'utilisateur qui fait la requête (sécurisé)
      return currentUserDocExists()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : null;
    }

    function getRole() {
      let data = getUserData();
      return data != null ? data.role : null;
    }

    function getUserSchoolId() {
      let data = getUserData();
      return data != null ? data.schoolId : null;
    }

    function isActive() {
      let data = getUserData();
      return data != null && (data.active == true || data.isActive == true);
    }

    function isUpdatingSaasFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'subscriptionPlan',
        'subscriptionStatus',
        'subscriptionStartDate',
        'subscriptionEndDate',
        'subscriptionRenewalDate',
        'nextPaymentDate',
        'isInternalSchool',
        'studentLimit',
        'studentsCount',
        'studentCount',
        'lastStudentCounterMutationId',
        'lastStudentCounterMutationType',
        'pilot',
        'billingStatus',
        'billingCycle',
        'trialEndsAt'
      ]);
    }

    function isUpdatingTransportPolicy() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(['transportPolicy']);
    }

    function isValidTransportPolicy() {
      let policy = request.resource.data.get('transportPolicy', {});
      let validKeys = policy.keys().hasOnly(['secretaryManageAll', 'feePolicyId', 'billingPeriods']);
      let validTypes = (!('secretaryManageAll' in policy) || policy.secretaryManageAll is bool)
        && (!('feePolicyId' in policy) || policy.feePolicyId == null
          || policy.feePolicyId == 'ITALO_PK_2026')
        && (!('billingPeriods' in policy)
          || (policy.billingPeriods is list && policy.billingPeriods.size() <= 24));
      return validKeys && validTypes;
    }

    function isAcademicCalendarPointerUpdate(schoolId) {
      let isAllowedRole = isSuperAdmin() || (hasSchoolAccess(schoolId) && (isAdminOrOwner() || isDirector()));
      let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();
      let onlyAllowedKeysChanged = affectedKeys.hasOnly(['activeAcademicYearId', 'updatedAt', 'updatedBy', 'version']);

      let validActiveYearId = !affectedKeys.hasAny(['activeAcademicYearId']) ||
                              request.resource.data.activeAcademicYearId == null ||
                              (request.resource.data.activeAcademicYearId is string && request.resource.data.activeAcademicYearId.size() > 0);

      let validUpdatedBy = !affectedKeys.hasAny(['updatedBy']) || request.resource.data.updatedBy == request.auth.uid;

      let validVersion = affectedKeys.hasAll(['version']) &&
                         request.resource.data.version is number &&
                         request.resource.data.version == (('version' in resource.data ? resource.data.version : 0) + 1);

      return isAllowedRole && onlyAllowedKeysChanged && validActiveYearId && validUpdatedBy && validVersion;
    }

    function isUpdatingSensitiveUserFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'role',
        'schoolId',
        'schoolIds',
        'active',
        'isActive',
        'status',
        'permissions',
        'claims',
        'customClaims',
        'studentIds',
        'mustChangePin'
      ]);
    }

    function isUpdatingStoredAuthSecret() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'password',
        'pin',
        'token',
        'credential'
      ]);
    }

    function isOwnerManagedRole(role) {
      return role in ['director', 'secretary', 'accountant', 'teacher', 'driver'];
    }

    function isDirectorManagedRole(role) {
      return role in ['secretary', 'accountant', 'teacher', 'driver'];
    }

    function isOperationalStaffRole(role) {
      return role in ['director', 'secretary', 'accountant', 'teacher', 'driver'];
    }

    function canCreateManagedUserRole(role) {
      return (isOwner() && isOwnerManagedRole(role))
        || (isDirector() && isDirectorManagedRole(role))
        || (isSuperAdmin() && isOperationalStaffRole(role));
    }

    function hasValidManagedUserSchool(data) {
      return data.schoolId is string
        && data.schoolId.size() > 0
        && (isSuperAdmin() || data.schoolId == getUserSchoolId());
    }

    function isStrictManagedUserCreate(data, userId) {
      return data.keys().hasAll([
          'id', 'email', 'role', 'schoolId', 'active', 'isActive', 'status', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'email', 'role', 'schoolId', 'active', 'isActive', 'status', 'createdAt'
        ])
        && data.id == userId
        && data.email is string
        && data.email.size() > 0
        && canCreateManagedUserRole(data.role)
        && hasValidManagedUserSchool(data)
        && data.active == true
        && data.isActive == true
        && data.status == 'active';
    }

    function canManageUserActivation(targetData) {
      return (
          isSuperAdmin() && targetData.role != 'superAdmin'
        ) || (
          isOwner()
          && targetData.schoolId == getUserSchoolId()
          && isOwnerManagedRole(targetData.role)
        ) || (
          isDirector()
          && targetData.schoolId == getUserSchoolId()
          && isDirectorManagedRole(targetData.role)
        );
    }

    function isValidUserActivationUpdate() {
      let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return affectedKeys.hasAny(['active', 'isActive', 'status'])
        && affectedKeys.hasOnly(['active', 'isActive', 'status', 'updatedAt', 'updatedBy'])
        && canManageUserActivation(resource.data)
        && request.resource.data.role == resource.data.role
        && request.resource.data.schoolId == resource.data.schoolId
        && request.resource.data.get('schoolIds', []) == resource.data.get('schoolIds', [])
        && request.resource.data.get('permissions', []) == resource.data.get('permissions', [])
        && request.resource.data.get('claims', {}) == resource.data.get('claims', {})
        && request.resource.data.get('customClaims', {}) == resource.data.get('customClaims', {})
        && request.resource.data.active is bool
        && request.resource.data.isActive is bool
        && request.resource.data.active == request.resource.data.isActive
        && (
          (request.resource.data.active == true && request.resource.data.status == 'active')
          || (request.resource.data.active == false && request.resource.data.status == 'inactive')
        );
    }

    function isPromotingToSuperAdmin() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
             && request.resource.data.role == 'superAdmin';
    }

    function isChangingSchoolId() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(['schoolId', 'schoolIds']);
    }

    function isUpdatingStudentActiveStatusFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'schoolingStatus',
        'departureReason',
        'departureDate',
        'departureNote',
        'deactivatedAt',
        'deactivatedBy',
        'reactivatedAt',
        'reactivatedBy'
      ]);
    }

    // --- Rôles ---
    function isSuperAdmin() {
      return getRole() == 'superAdmin';
    }
    function isOwner() {
      return getRole() == 'owner';
    }
    function isDirector() {
      return getRole() == 'director';
    }
    function isSecretary() {
      return getRole() == 'secretary';
    }
    function isAccountant() {
      return getRole() == 'accountant';
    }
    function isTeacher() {
      return getRole() == 'teacher';
    }
    function isDriver() {
      return getRole() == 'driver';
    }
    function isParent() {
      return getRole() == 'parent';
    }
    function isStudent() {
      return getRole() == 'student';
    }
    function isBoardViewer() {
      return getRole() == 'boardViewer';
    }

    // --- Droits Composés ---
    function isAdminOrOwner() {
      return isSuperAdmin() || isOwner();
    }
    function hasSchoolAccess(schoolId) {
      return isSuperAdmin() || getUserSchoolId() == schoolId;
    }
    function canManageSchool(schoolId) {
      return isSuperAdmin() || (isOwner() && getUserSchoolId() == schoolId);
    }
    function canManagePedagogy(schoolId) {
      return hasSchoolAccess(schoolId) && (isAdminOrOwner() || isDirector() || isSecretary());
    }

    function canSecretaryManageAllTransport(schoolId) {
      let schoolPath = /databases/$(database)/documents/schools/$(schoolId);
      return isAuthenticated() && isActive() && isSecretary() && hasSchoolAccess(schoolId) &&
             exists(schoolPath) &&
             get(schoolPath).data.get('transportPolicy', {}).get('secretaryManageAll', false) == true;
    }

    function isAcademicProgramManager() {
      return isSuperAdmin() || isOwner() || isDirector();
    }

    function isTeacherAssignedToClassSubject(schoolId, academicYearId, classId, classSubjectId) {
      let staffLink = get(/databases/$(database)/documents/staffUserLinkByUser/$(request.auth.uid));
      let classSubjectPath = /databases/$(database)/documents/classSubjects/$(classSubjectId);
      let hasClassSubject = exists(classSubjectPath);
      let catalogSubjectId = hasClassSubject
        ? get(classSubjectPath).data.get('catalogSubjectId', get(classSubjectPath).data.subjectId)
        : classSubjectId;
      let assignmentPath = /databases/$(database)/documents/teacherAssignments/$(schoolId + '__' + academicYearId + '__' + classId + '__' + catalogSubjectId + '__' + staffLink.data.staffId);
      return isAuthenticated()
        && isTeacher()
        && exists(/databases/$(database)/documents/staffUserLinkByUser/$(request.auth.uid))
        && staffLink.data.isActive == true
        && staffLink.data.schoolId == schoolId
        && (!hasClassSubject || (
          get(classSubjectPath).data.schoolId == schoolId
          && get(classSubjectPath).data.academicYearId == academicYearId
          && get(classSubjectPath).data.classId == classId
        ))
        && exists(assignmentPath)
        && get(assignmentPath).data.get('status', 'active') == 'active'
        && get(assignmentPath).data.isActive == true;
    }

    function hasValidStudentClass(studentData) {
      let classPath = /databases/$(database)/documents/classes/$(studentData.classId);
      let classData = get(classPath).data;
      return studentData.classId is string
        && studentData.classId.size() > 0
        && exists(classPath)
        && classData.schoolId == studentData.schoolId
        && (
          !('isActive' in classData)
          || classData.isActive != false
        );
    }

    function hasValidStudentAcademicYear(studentData) {
      let yearPath = /databases/$(database)/documents/academicYears/$(studentData.academicYearId);
      let schoolPath = /databases/$(database)/documents/schools/$(studentData.schoolId);
      let yearData = get(yearPath).data;
      let schoolData = get(schoolPath).data;
      return studentData.academicYearId is string
        && studentData.academicYearId.size() > 0
        && exists(yearPath)
        && exists(schoolPath)
        && yearData.schoolId == studentData.schoolId
        && yearData.status == 'active'
        && studentData.registrationYear == yearData.name
        && (
          !('activeAcademicYearId' in schoolData)
          || schoolData.activeAcademicYearId == studentData.academicYearId
        );
    }

    function isValidStudentCreate(studentData, studentId) {
      return studentData.keys().hasAll([
          'id', 'schoolId', 'academicYearId', 'registrationYear', 'schoolingStatus',
          'matricule', 'matriculeNormalized', 'matriculeReservationId',
          'duplicateFingerprint', 'duplicateReservationId',
          'name', 'studentLastName', 'studentFirstName', 'gender',
          'section', 'classId', 'studentStatus',
          'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
        ])
        && studentData.keys().hasOnly([
          'id', 'schoolId', 'academicYearId', 'registrationYear', 'schoolingStatus',
          'matricule', 'matriculeNormalized', 'matriculeReservationId',
          'duplicateFingerprint', 'duplicateReservationId',
          'name', 'studentLastName', 'studentFirstName', 'gender',
          'section', 'classId', 'studentStatus',
          'busId', 'usesTransport', 'transportFleet', 'transportStatus',
          'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
        ])
        && studentData.id is string
        && studentData.id == studentId
        && studentData.schoolId is string
        && studentData.schoolId.size() > 0
        && studentData.registrationYear is string
        && studentData.registrationYear.size() > 0
        && studentData.schoolingStatus == 'active'
        && studentData.matricule is string
        && studentData.matricule.size() > 0
        && studentData.matricule == studentData.matriculeNormalized
        && studentData.matriculeNormalized.matches('^[A-Z0-9][A-Z0-9._-]{0,63}$')
        && studentData.matriculeReservationId == studentData.schoolId + '__' + studentData.matriculeNormalized
        && studentData.duplicateFingerprint is string
        && studentData.duplicateFingerprint.size() > 0
        && studentData.duplicateFingerprint.size() <= 300
        && studentData.duplicateReservationId == studentData.schoolId + '__' + studentData.duplicateFingerprint
        && studentData.name is string
        && studentData.name.size() > 0
        && studentData.studentLastName is string
        && studentData.studentLastName.size() > 0
        && studentData.studentFirstName is string
        && studentData.studentFirstName.size() > 0
        && studentData.gender in ['M', 'F']
        && studentData.section in ['francophone', 'anglophone']
        && studentData.classId is string
        && studentData.classId.size() > 0
        && studentData.studentStatus in ['nouveau', 'ancien']
        && studentData.createdAt == request.time
        && studentData.updatedAt == request.time
        && studentData.createdBy == request.auth.uid
        && studentData.updatedBy == request.auth.uid
        && hasValidStudentAcademicYear(studentData)
        && hasValidStudentCreationReservations(studentData, studentId)
        && hasValidStudentRestrictedDocuments(studentData, studentId);
    }

    function hasValidStudentRestrictedDocuments(studentData, studentId) {
      let privatePath = /databases/$(database)/documents/studentPrivate/$(studentId);
      let financePath = /databases/$(database)/documents/studentFinance/$(studentId);
      let parentPrivatePath = /databases/$(database)/documents/studentParentPrivate/$(studentId);
      let parentFinancePath = /databases/$(database)/documents/studentParentFinance/$(studentId);
      let privateData = getAfter(privatePath).data;
      let financeData = getAfter(financePath).data;
      let parentPrivateData = getAfter(parentPrivatePath).data;
      let parentFinanceData = getAfter(parentFinancePath).data;
      return existsAfter(privatePath)
        && privateData.schoolId == studentData.schoolId
        && privateData.studentId == studentId
        && existsAfter(financePath)
        && financeData.schoolId == studentData.schoolId
        && financeData.studentId == studentId
        && existsAfter(parentPrivatePath)
        && parentPrivateData.schoolId == studentData.schoolId
        && parentPrivateData.studentId == studentId
        && existsAfter(parentFinancePath)
        && parentFinanceData.schoolId == studentData.schoolId
        && parentFinanceData.studentId == studentId;
    }

    function hasValidStudentCreationReservations(studentData, studentId) {
      let matriculePath = /databases/$(database)/documents/studentMatriculeReservations/$(studentData.matriculeReservationId);
      let duplicatePath = /databases/$(database)/documents/studentDuplicateReservations/$(studentData.duplicateReservationId);
      let matriculeData = getAfter(matriculePath).data;
      let duplicateData = getAfter(duplicatePath).data;
      return existsAfter(matriculePath)
        && matriculeData.schoolId == studentData.schoolId
        && matriculeData.studentId == studentId
        && matriculeData.matriculeNormalized == studentData.matriculeNormalized
        && existsAfter(duplicatePath)
        && duplicateData.schoolId == studentData.schoolId
        && duplicateData.duplicateFingerprint == studentData.duplicateFingerprint
        && studentId in duplicateData.studentIds;
    }

    function hasInitializedStudentCounter(school) {
      return 'studentsCount' in school
          && school.studentsCount is int
          && school.studentsCount >= 0;
    }

    function hasStudentQuotaCapacity(school) {
      let isInternal = school.get('isInternalSchool', false) == true;
      let plan = school.get('subscriptionPlan', 'starter');
      let hasConfiguredLimit = 'studentLimit' in school
          && school.studentLimit is int
          && school.studentLimit >= 0;

      return isInternal
          || plan == 'premium'
          || (hasConfiguredLimit && school.studentsCount < school.studentLimit)
          || (!hasConfiguredLimit && plan == 'pilot' && school.studentsCount < 1000)
          || (!hasConfiguredLimit && plan == 'standard' && school.studentsCount < 1000)
          || (!hasConfiguredLimit && plan == 'starter' && school.studentsCount < 200);
    }

    function isValidStudentCounterMutation(schoolId, school, nextSchool) {
      let studentId = nextSchool.get('lastStudentCounterMutationId', '');
      let mutationType = nextSchool.get('lastStudentCounterMutationType', '');
      let studentPath = /databases/$(database)/documents/students/$(studentId);
      let onlyCounterFields = nextSchool.diff(school).affectedKeys().hasOnly([
        'studentsCount', 'lastStudentCounterMutationId', 'lastStudentCounterMutationType',
        'updatedAt', 'updatedBy'
      ]);
      let commonValid = canManagePedagogy(schoolId)
          && hasInitializedStudentCounter(school)
          && nextSchool.studentsCount is int
          && nextSchool.studentsCount >= 0
          && nextSchool.updatedAt == request.time
          && nextSchool.updatedBy == request.auth.uid
          && studentId != ''
          && onlyCounterFields;
      return commonValid && (
        mutationType == 'deactivate' ? (
          school.studentsCount > 0
          && exists(studentPath)
          && get(studentPath).data.schoolId == schoolId
          && get(studentPath).data.get('schoolingStatus', 'active') == 'active'
          && getAfter(studentPath).data.schoolingStatus == 'inactive'
          && nextSchool.studentsCount == school.studentsCount - 1
        ) : mutationType == 'reactivate' && (
          hasStudentQuotaCapacity(school)
          && exists(studentPath)
          && get(studentPath).data.schoolId == schoolId
          && get(studentPath).data.schoolingStatus == 'inactive'
          && getAfter(studentPath).data.schoolingStatus == 'active'
          && nextSchool.studentsCount == school.studentsCount + 1
        )
      );
    }

    function hasAtomicCounterForStudentStatusUpdate(studentId, student, nextStudent) {
      let changesStatus = nextStudent.diff(student).affectedKeys().hasAny(['schoolingStatus']);
      let expectedType = student.get('schoolingStatus', 'active') == 'active'
          ? 'deactivate'
          : 'reactivate';
      return !changesStatus || (
        nextStudent.schoolId == student.schoolId
        && getAfter(/databases/$(database)/documents/schools/$(student.schoolId)).data.lastStudentCounterMutationId == studentId
        && getAfter(/databases/$(database)/documents/schools/$(student.schoolId)).data.lastStudentCounterMutationType == expectedType
      );
    }

    // ==========================================
    // RULES PER COLLECTION
    // ==========================================

    // Par défaut, tout refuser.
    match /{document=**} {
      allow read, write: if false;
    }

    // --- USERS ---
    match /users/{userId} {
      // Un utilisateur peut lire son propre document.
      // Le superAdmin peut lire tous les utilisateurs.
      // L'owner, le directeur et la secrétaire peuvent lire les utilisateurs de leur école.
      allow get: if isAuthenticated() && request.auth.uid == userId;
      allow get: if isAuthenticated() && isActive() && (
        isSuperAdmin() ||
        ((isOwner() || isDirector() || isSecretary()) && hasSchoolAccess(resource.data.schoolId))
      );
      allow list: if isAuthenticated() && isActive() && (
        isSuperAdmin() ||
        ((isOwner() || isDirector() || isSecretary()) && hasSchoolAccess(resource.data.schoolId))
      );

      // Création administrative strictement limitée aux rôles ITALO autorisés,
      // ou auto-inscription Parent via son invitation dédiée.
      allow create: if isAuthenticated() && (
        (isActive() && isStrictManagedUserCreate(request.resource.data, userId)) ||
        (
          request.auth.uid == userId &&
          request.resource.data.role == 'parent' &&
          request.resource.data.keys().hasAll(['inviteId', 'studentIds']) &&
          get(/databases/$(database)/documents/parent_invitations/$(request.resource.data.inviteId)).data.status == 'pending' &&
          get(/databases/$(database)/documents/parent_invitations/$(request.resource.data.inviteId)).data.parentEmailLower == request.auth.token.email &&
          get(/databases/$(database)/documents/parent_invitations/$(request.resource.data.inviteId)).data.schoolId == request.resource.data.schoolId &&
          request.resource.data.studentIds == get(/databases/$(database)/documents/parent_invitations/$(request.resource.data.inviteId)).data.studentIds &&
          !request.resource.data.keys().hasAny([
            'isInternalSchool', 'subscriptionPlan', 'studentLimit', 'pilot',
            'permissions', 'claims', 'customClaims', 'password', 'pin', 'token', 'credential'
          ])
        )
      );
      allow update: if isAuthenticated() && isActive() && !isBoardViewer() && (
        isValidUserActivationUpdate() ||
        (
          (
            isSuperAdmin()
            || request.auth.uid == userId
            || (isOwner() && hasSchoolAccess(resource.data.schoolId))
          ) &&
          !isUpdatingSensitiveUserFields() &&
          !isUpdatingStoredAuthSecret()
        )
      );
      // Suppression physique réservée aux opérations backend/Admin SDK contrôlées.
      allow delete: if false;
    }

    // --- SCHOOLS ---
    match /schools/{schoolId} {
      allow read: if isAuthenticated() && isActive() && hasSchoolAccess(schoolId);

      // Seul le superAdmin peut créer ou supprimer des écoles
      allow create: if isAuthenticated() && isSuperAdmin() && isValidTransportPolicy();
      allow delete: if isAuthenticated() && isSuperAdmin();
      // Le propriétaire peut modifier son école (mais pas l'abonnement SaaS ni le pointeur de manière non atomique)
      allow update: if isAuthenticated() && isActive() && (
        (request.resource.data.diff(resource.data).affectedKeys().hasAny(['studentsCount'])
          && isValidStudentCounterMutation(schoolId, resource.data, request.resource.data)) ||
        (isSuperAdmin() && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'studentsCount', 'lastStudentCounterMutationId', 'lastStudentCounterMutationType'
        ])) ||
        (canManageSchool(schoolId) && !isUpdatingSaasFields() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['activeAcademicYearId'])) ||
        (isAcademicCalendarPointerUpdate(schoolId) && !isUpdatingTransportPolicy())
      ) && (!isUpdatingTransportPolicy() || (isValidTransportPolicy() && (isOwner() || isSuperAdmin())))
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['schoolId']);

      match /secrets/{secretId} {
        allow read: if false;
        allow create, update: if isAuthenticated() && isActive() && (isSuperAdmin() || isOwner()) && hasSchoolAccess(schoolId);
        allow delete: if isAuthenticated() && isActive() && isSuperAdmin();
      }
    }

    // --- PARENT INVITATIONS ---
    match /parent_invitations/{inviteId} {
      allow read: if isAuthenticated() && isActive() && (isAdminOrOwner() || isDirector() || isSecretary()) && hasSchoolAccess(resource.data.schoolId);
      allow get: if resource.data.status == 'pending' && resource.data.expiresAt > request.time; // Not fully possible to compare string ISO with toMillis simply in rules if it's stored as string. Wait, ISO strings can be compared directly in lexicographical order!
      // Better yet, just check pending. The client checks expiration, or we can check string:
      // allow get: if resource.data.status == 'pending'; (the UI will check expiration)

      allow create: if isAuthenticated() && isActive() && (isAdminOrOwner() || isDirector() || isSecretary()) && hasSchoolAccess(request.resource.data.schoolId);

